# 실 API 연동 시 채울 것 — 오프라인 테스트는 이 파일 없이도 전부 통과한다
# (tests는 COSCIENTIST_DACON_FAKE_HTTP로 HTTP를 대체한다).

# DACON 제출 API — scripts/dacon_submit.py가 셋 다 요구한다
# 토큰: 마이페이지 > 계정관리에서 발급
DACON_API_TOKEN=
# 대회 ID — 대회 URL의 숫자 (예: dacon.io/competitions/official/235954 → 235954)
DACON_CPT_ID=
# 대회 페이지 "Competitions > Details > Teams" 탭에 표시된 정확한 팀명
DACON_TEAM_NAME=

# wandb 실험 관리 (학습 스크립트에서만 사용, 선택)
WANDB_API_KEY=
WANDB_PROJECT=ai-co-scientist
WANDB_ENTITY=
