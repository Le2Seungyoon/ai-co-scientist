# 실 API 연동 시 채울 것 — 지금은 config.yaml의 mock: true라 전부 비어 있어도 동작함 (README 참고)

# Gemini API (Google AI Studio에서 발급) - https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# wandb 실험 관리
WANDB_API_KEY=
WANDB_PROJECT=ai-co-scientist
WANDB_ENTITY=

# DACON 공개 API 토큰 — 마이페이지 > 계정관리에서 발급
DACON_API_TOKEN=
# 대회 ID — 대회 URL의 숫자 (예: dacon.io/competitions/official/235954 → 235954)
DACON_CPT_ID=
# 대회 페이지 "Competitions > Details > Teams" 탭에 표시된 정확한 팀명
DACON_TEAM_NAME=

# 웹서치 (예: Tavily/SerpAPI 등 M5+ 연동 시)
WEBSEARCH_API_KEY=
